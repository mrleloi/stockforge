# StockForge Environment Variables
# Copy to .env and fill in values. NEVER commit .env to git.

# ===== LLM APIs =====
ANTHROPIC_API_KEY=your-key-here
OPENAI_API_KEY=your-key-here  # for embeddings + optional Whisper API

# ===== Database =====
DATABASE_URL=postgresql://stockforge:stockforge_dev_only@localhost:5432/stockforge
# After docker-compose up, apply extensions:
#   CREATE EXTENSION timescaledb; CREATE EXTENSION vector; CREATE EXTENSION pg_trgm;

# ===== Redis =====
REDIS_URL=redis://localhost:6379/0

# ===== Storage (Cloudflare R2 — S3-compatible) =====
R2_ACCOUNT_ID=your-account
R2_ACCESS_KEY_ID=your-key
R2_SECRET_ACCESS_KEY=your-secret
R2_BUCKET_RAW=stockforge-raw           # financial reports, transcripts
R2_BUCKET_PROCESSED=stockforge-processed  # derived artifacts

# ===== Data Sources =====
# Free sources (Phase 1)
VNSTOCK_ENABLED=true
TCBS_API_ENABLED=true
VIETSTOCK_SCRAPE_ENABLED=true

# Paid sources (Phase 2-3 if budget)
FIINPRO_API_KEY=                        # leave empty for free tier only
WICHART_API_KEY=

# YouTube Data API (for channel monitoring)
YOUTUBE_API_KEY=your-key-here

# ===== Scraping Identity (BR-1/I-S34 compliance) =====
SCRAPER_USER_AGENT="StockForge/0.1 (research; contact: your-email@example.com)"
SCRAPER_RATE_LIMIT_RPM=20               # requests per minute
SCRAPER_RESPECT_ROBOTS=true

# ===== Cost Caps (I-40, I-41, I-42) =====
DAILY_BUDGET_USD=10.00
SESSION_BUDGET_USD=25.00
PER_THESIS_BUDGET_USD=3.00
PER_KOL_INGESTION_BUDGET_USD=2.00

# ===== Feature Flags =====
FF_KOL_TRACKING_ENABLED=false           # Phase 2+
FF_CROWD_SENTIMENT_ENABLED=false        # Phase 2+
FF_PUMP_DETECTION_ENABLED=false         # Phase 3+
FF_OUTER_LOOP_ENABLED=false             # Year 2
FF_MULTI_PERSPECTIVE_FULL=false         # Phase 3+, start with 3 perspectives

# ===== Transcription =====
WHISPER_MODE=local                      # local | api
WHISPER_MODEL=small                     # tiny | base | small | medium | large
WHISPER_API_KEY=                        # if WHISPER_MODE=api (uses OpenAI)

# ===== Environment =====
PYTHON_ENV=development                  # development | production
LOG_LEVEL=INFO
TIMEZONE=Asia/Ho_Chi_Minh

# ===== Observability (Phase 3+) =====
SENTRY_DSN=
POSTHOG_API_KEY=

# ===== Market Data =====
TRADING_HOURS_START=09:00               # VN market hours
TRADING_HOURS_END=15:00
MARKET_TIMEZONE=Asia/Ho_Chi_Minh

# ===== Personal Preferences =====
PORTFOLIO_CURRENCY=VND
DEFAULT_LOOKBACK_DAYS=365
DEFAULT_HOLDING_PERIOD=MONTHS
