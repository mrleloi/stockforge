agent-workspace/memory/.session-hooks.log
agent-workspace/memory/.wind-down
agent-workspace/memory/.wind-down-fired
agent-workspace/memory/.auto-reboot-FAILED
agent-workspace/memory/.autonomous-stop-watchdog.log
agent-workspace/memory/.continue-fired-*
agent-workspace/memory/.session-ready
