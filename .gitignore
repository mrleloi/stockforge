# SQLite databases (sync-tracker, self-awareness — Tracks 8a, 9)
agent-workspace/memory/sync-tracker/*.db
agent-workspace/memory/sync-tracker/*.db-journal
agent-workspace/memory/self-awareness/*.db
agent-workspace/memory/self-awareness/*.db-journal

# Learning-data write-heavy store (Track 5.5d.1, D-005)
# events/ + archive/ are write-heavy NDJSON streams; gitignored due to volume + ephemerality.
# index/ + dogfood/ + loop/ are tracked (small reference artifacts).
agent-workspace/learning-data/events/
agent-workspace/learning-data/archive/
